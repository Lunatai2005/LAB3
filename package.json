{
  "name": "lab3-ecommerce-microservices",
  "version": "2.0.0",
  "private": true,
  "description": "E-commerce MVP microservices with API Gateway and choreography saga",
  "scripts": {
    "generate": "npm run generate:auth && npm run generate:catalog && npm run generate:order && npm run generate:shipping",
    "generate:auth": "prisma generate --config services/auth/prisma.config.ts",
    "generate:catalog": "prisma generate --config services/catalog/prisma.config.ts",
    "generate:order": "prisma generate --config services/order/prisma.config.ts",
    "generate:shipping": "prisma generate --config services/shipping/prisma.config.ts",
    "build": "npm run generate && tsc",
    "typecheck": "npm run generate && tsc --noEmit",
    "dev:gateway": "tsx watch services/api-gateway/src/server.ts",
    "dev:auth": "tsx watch services/auth/src/server.ts",
    "dev:catalog": "tsx watch services/catalog/src/server.ts",
    "dev:order": "tsx watch services/order/src/server.ts",
    "dev:shipping": "tsx watch services/shipping/src/server.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "http-proxy-middleware": "^3.0.5",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "morgan": "^1.12.1",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
